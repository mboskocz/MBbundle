#calculcating IA and IE indices
data$IA_a1 <- (data$PH_a1-data$PFA_a1)/100
data$IE_a1 <- (data$PH_a1+data$PFA_a1)/2/100
return(data) #returns a dataframe with overclaiming calcuations
}

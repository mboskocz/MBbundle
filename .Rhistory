calc_weighted_effect_size <- function(formula, design, data) {
# 1. Extrakce názvů proměnných z formule
dep_var <- all.vars(formula)[1]  # např. ST268_TT
indep_var <- all.vars(formula)[2] # např. ST004D01T
# 2. Výpočet průměrů a rozptylů pomocí survey balíčku
means_obj <- svyby(as.formula(paste("~", dep_var)), as.formula(paste("~", indep_var)), design, svymean)
vars_obj  <- svyby(as.formula(paste("~", dep_var)), as.formula(paste("~", indep_var)), design, svyvar, na.rm=TRUE)
# Získání hodnot (převod na list pro univerzálnost)
groups <- means_obj[[indep_var]]
means <- means_obj[[dep_var]]
vars  <- vars_obj[[dep_var]]
# 3. Výpočet vah (sumy vah pro každou skupinu)
# Dynamicky projdeme všechny skupiny v indep_var
w_sums <- sapply(groups, function(g) {
sum(data$W_FSTUWT[data[[indep_var]] == g], na.rm = TRUE)
})
# 4. Výpočet sd_pooled (vážený sd)
# Vzorec: sqrt( (sum(w_i * var_i)) / sum(w_i) )
sd_pooled <- sqrt(sum(w_sums * vars) / sum(w_sums))
# 5. Výpočet Cohenova d (pro dvě skupiny)
if(length(means) == 2) {
cohens_d <- (means[1] - means[2]) / sd_pooled
} else {
cohens_d <- "Více než 2 skupiny - Cohenovo d nelze přímo spočítat"
}
# 6. t-test
t_test <- svyttest(formula, design = design)
# Výstup
cat("--- Analýza skupiny:", indep_var, "---\n")
cat("Průměry:", paste(groups, "=", round(means/1000, 2), collapse=", "), "\n")
cat("Vážené Cohenovo d:", ifelse(is.numeric(cohens_d), round(cohens_d, 3), cohens_d), "\n\n")
return(list(means = means/1000, d = cohens_d, t_test = t_test))
}

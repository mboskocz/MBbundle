model <- '
# Measurement model
schoolAI =~ schoolAI_introduce + schoolAI_prepareme + schoolAI_use
futilityAItech_EFL =~ futilityAItech_EFLtranslation_translators + futilityAItech_EFLtranslation_smartmachine + futilityAItech_EFLlearningreplaced
demotivation_EFL =~ demotivation_EFLnocare + demotivation_EFLloosingtime + demotivation_EFLnounderstaning
# Structural (regression) model
futilityAItech_EFL ~ schoolAI + test_score
demotivation_EFL ~ schoolAI + futilityAItech_EFL + test_score
'
fit <- sem(model, data = data_AItechamotivation)
attach(data_AItechamotivation)
schoolAI_introduce<-AIskola.SQ01. #yes, 1=nesouhlas, 4=souhlas, Škola nás seznamuje s tím, jak bychom měli správně pracovat s nástroji s generativní umělou inteligencí (např. ChatGPT, Gemini, Copilot, Midjourney, DALL-E).]
schoolAI_introduce<-AIskola.SQ01..y #yes, 1=nesouhlas, 4=souhlas, Škola nás seznamuje s tím, jak bychom měli správně pracovat s nástroji s generativní umělou inteligencí (např. ChatGPT, Gemini, Copilot, Midjourney, DALL-E).]
schoolAI_rules<-AIskola.SQ02..y #Škola má stanovená pravidla pro to, jak můžeme využivat nástroje s generativní umělou inteligencí (např. ChatGPT, Gemini, Copilot, Midjourney, DALL-E).
schoolAI_prepareme<-AIskola.SQ03..y #yes, Škola má stanovená pravidla pro to, jak můžeme využivat nástroje s generativní umělou inteligencí (např. ChatGPT, Gemini, Copilot, Midjourney, DALL-E).]
schoolAI_use<-AIskola.SQ04..y # yes, Škola nám umožňuje používat nástroje s generativní umělou inteligencí (např. ChatGPT, Gemini, Copilot, Midjourney, DALL-E) během výuky anglického jazyka.]
futilityAItech_EFLesseys<-TS02.SQ01..y #[Učit se psát eseje v angličtině nemá smysl, protože nástroje s generativní umělou inteligencí (např. ChatGPT, Gemini, Copilot) text napíší za mě.]
futilityAItech_EFLtranslation_translators<-TS02.SQ02..y #yes, Učit se anglicky nemá smysl, protože v budoucnu budou existovat dostupné kvalitní překladače.]
futilityAItech_EFLtranslation_smartmachine<-TS02.SQ03..y #yes : [Kdybych měl(a) k dispozici chytré zařízení, které mi v reálném čase přeloží, co říká člověk v jiném jazyce, neučil(a) bych se anglicky.]
futilityAItech_EFLlearningunimportant<-TS02.SQ04..y #Myslím si, že umět anglicky nebude v budoucnu tak důležité, jako je tomu teď.]
futilityAItech_EFLlearningreplaced<-TS02.SQ05..y #yes, Myslím si, že mi v budoucnu bude ke komunikaci se světem stačit můj rodný jazyk a překladač.
demotivation_EFLnocare<-Demotiv1.SQ01..y #Vlastně ani nevím, proč se učím anglicky a upřímně, vůbec mě angličtina nezajímá.
demotivation_EFLloosingtime<-Demotiv2.SQ02..y #Upřímně, mám opravdu dojem, že učit se anglicky je ztráta času.
demotivation_EFLnounderstaning<-Demotiv3.SQ03..y #Já opravdu nevím, vůbec nemůžu pochopit, proč se učím anglicky.
data_AItechamotivation<-data.frame(cbind(dot_kod,school_ID,schoolAI_introduce,schoolAI_rules,schoolAI_prepareme,schoolAI_use,teacher_AIuse_nr,teacher_AIuse_any,teacher_AItask_nr,teacher_AItask_any,futilityAItech_EFLesseys,futilityAItech_EFLtranslation_translators,futilityAItech_EFLtranslation_smartmachine,futilityAItech_EFLlearningunimportant,futilityAItech_EFLlearningreplaced,demotivation_EFLnocare,demotivation_EFLloosingtime,demotivation_EFLnounderstaning,test_score,test_level,test_level_A,test_level_B,test_level_C,school_gym,school_sosser,school_sostech,school_souser,school_soutech))[wave2==1,]

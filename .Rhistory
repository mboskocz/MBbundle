overclaiming.calc <- function (data,existIt,nonexistIt,scaleStart=1,scaleStop=5) {
#PISA 2012
#exist <- c("ST62Q01","ST62Q02","ST62Q03","ST62Q06", "ST62Q07", "ST62Q08","ST62Q09", "ST62Q10", "ST62Q12", "ST62Q15", "ST62Q16", "ST62Q17", "ST62Q19")

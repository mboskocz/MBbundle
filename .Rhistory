model_test_int <- '
# 1. Definice měření
amotivation =~ Demotiv1.SQ01..y + Demotiv1.SQ02..y + Demotiv1.SQ03..y
Tech_EFL_Futility =~ TS02.SQ05..y + TS02.SQ02..y + TS02.SQ03..y
AI_sch_ready =~ AIskola.SQ01..y + AIskola.SQ04..y + AIskola.SQ03..y
# 2. NOVÉ: Definice latentní interakce ze součinových indikátorů
Int_ETA_x_AIsch =~ AIskola.SQ01..y.ETA_body_celkem.y +
AIskola.SQ04..y.ETA_body_celkem.y +
AIskola.SQ03..y.ETA_body_celkem.y
